DJANGO_SETTINGS_MODULE=config.settings.dev
DEBUG=True
SECRET_KEY=change-this-to-a-long-random-string
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/cafe_db
REDIS_URL=redis://localhost:6379/0

# ملی پیامک — Console API (توکن اصلی)
MELIPAYAMAK_API_TOKEN=
MELIPAYAMAK_FROM=
# اعتبارات قدیمی (فقط fallback اگر Console API کار نکرد)
MELIPAYAMAK_USERNAME=
MELIPAYAMAK_PASSWORD=

# پیامک‌های غیر-OTP (ثبت سفارش و تحویل به پیک — فقط سفارش‌های ارسال با پیک)
SMS_NOTIFICATIONS_ENABLED=True

# زرین پال
# برای sandbox: ZARINPAL_MERCHANT=00000000-0000-0000-0000-000000000000
ZARINPAL_MERCHANT=00000000-0000-0000-0000-000000000000
ZARINPAL_SANDBOX=True
ZARINPAL_CALLBACK_URL=http://localhost:3000/payment/callback

# Push Notification (Web Push / VAPID) — با `python manage.py generate_vapid_keys` تولید کن
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=mailto:admin@example.com

# Storage (برای لوکال فعلاً False)
USE_S3=False
MEDIA_ROOT=media/

# کد OTP ثابت برای تست (فقط وقتی DEBUG=True است)
OTP_TEST_CODE=

# بک‌آپ دیتابیس — مسیر مقصد و تعداد نگه‌داری (پیش‌فرض‌ها کافی‌اند، معمولاً نیازی به تغییر نیست)
# DBBACKUP_LOCATION=
# DBBACKUP_CLEANUP_KEEP=14
