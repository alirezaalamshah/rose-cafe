# فایل‌های بک‌آپ دیتابیس — حاوی داده‌ی واقعی کاربران (شماره موبایل و ...) هستند
# و نباید هیچ‌وقت وارد گیت شوند
/backups/

# لاگ‌های اپ (شماره تلفن، پاسخ خام زرین‌پال و ...)
/logs/
*.log

# رمزها و توکن‌های واقعی (دیتابیس، ملی‌پیامک، زرین‌پال و ...) — به‌جایش .env.example را commit کن
.env
.env.*
!.env.example

venv/
__pycache__/
*.pyc
