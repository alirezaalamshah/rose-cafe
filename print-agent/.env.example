# آدرس API بک‌اند — بدون اسلش انتهایی
API_BASE_URL=https://rccoffee.ir/api

# همان مقدار PRINT_AGENT_API_KEY تنظیم‌شده در بک‌اند (backend/.env)
PRINT_AGENT_API_KEY=

# هر چند ثانیه یک‌بار سرور را برای فیش‌های جدید چک کند
POLL_INTERVAL_SECONDS=5

# نام Share پرینتر در ویندوز (نه اسم دستگاه) — در Devices and Printers روی
# پرینتر راست‌کلیک > Printer properties > تب Sharing > Share name.
# روی mac/لینوکس همان نام پرینتر در CUPS (با دستور lpstat -p قابل مشاهده است).
PRINTER_NAME=

# عرض قابل‌چاپ پرینتر به پیکسل (نه میلی‌متر کاغذ) — مقدار رایج:
#   پرینتر ۵۸mm: 384
#   پرینتر ۸۰mm: 576
PRINTER_WIDTH_PX=576
